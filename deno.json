{
  "name": "@silly/linux",
  "version": "0.1.0",
  "exports": "./mod.ts",
  "tasks": {
    "start-peer": "cd client && deno task start",
    "test": "deno run --allow-env --config deno.json --location http://localhost client/public/tests.js",
    "provision": "./provision.sh",
    "package": "deno run -A .deno/to-npm.js",
    "publish": "cd npm && npm publish",
    "start-proxy": "caddy run --config Caddyfile",
    "start-old": "deno run -A --unstable mod.js",
    "start": "deno task start-peer",
    "compile-client": "deno compile -A --output p98 client.js",
    "provision-api": "cd server/api && ./provision.sh",
    "start-api": "cd server/api && deno -A index.js",
    "reverse-api": "ssh -N -R 3003:localhost:3003 local.$USER.me",
    "start-client": "deno run -A client.js",
    "debug-client": "deno run -A --inspect-brk client.js",
    "reverse-client": "ssh -N -R 1998:localhost:1024 local.$USER.me",

    "vendor": "deno run -A vendor.ts",

    "deploy-peer": "cd client && deno task deploy",
    "deploy-peer": "cd client && deployctl deploy --no-static --entrypoint=./server.js --prod --exclude=./private --exclude=.env --include=./public --include=./server.js --env-file",
    "debug-peer": "cd client && deno run -A --inspect-brk server.js",
    "reverse-peer": "ssh -N -R 1024:localhost:1024 $USER.plan98.org",
    "start-was": "cd server/was/wallet-attached-storage-server-main && CORS_ALLOW_ALL_ORIGINS=TRUE PORT=1088 npm run dev",
    "reverse-was": "ssh -N -R 1024:localhost:1024 $USER.wallet.storage",
    "start-server": "plan98client=$(pwd)/client; cd distros/subsystems/rust-9p/example/unpfs && cargo run --release 'tcp!0.0.0.0!7777' $plan98client",
    "reverse-server": "ssh -N -R 7777:localhost:7777 drive.$USER.me",
    "start-identity": "deno run -A identity.js",
    "reverse-identity": "ssh -N -R 3001:localhost:3001 wallet.$USER.me",
    "start-modules": "cd ../SourceCode/esm.sh && go run main.go --config=config.json --dev",
    "reverse-modules": "ssh -N -R 8090:localhost:8090 esm.$USER.me",
    "start-relay": "cd server/relay && npm start",
    "reverse-relay": "ssh -N -R 8765:localhost:8765 relay.$USER.me",
    "provision-braidmail": "cd server/braidmail && ./provision.sh",
    "start-braidmail": "cd server/braidmail/braidmail-main && node server-demo.js",
    "reverse-braidmail": "ssh -N -R 7465:localhost:7465 braidmail.$USER.me",
    "provision-verison-control": "cd server/braid-text && ./provision.sh",
    "start-version-control": "cd server/braid-text/braid-text-master && node server-demo.js",
    "reverse-version-control": "ssh -N -R 8888:localhost:8888 braidmail.$USER.me",
    "provision-solid": "cd server/solid && ./provision.sh",
    "start-solid": "cd server/solid/CommunitySolidServer-main && npm start",
    "reverse-solid": "ssh -N -R 3000:localhost:3000 pod.$USER.me",
    "provision-activity-pub": "cd server/activity-pub && ./provision.sh",
    "start-activity-pub": "cd server/activity-pub/express-activitypub-master && node index.js",
    "reverse-activity-pub": "ssh -N -R 3002:localhost:3002 pub.$USER.me",
    "provision-translate": "cd server/libretranslate && ./provision.sh",
    "start-translate": "cd server/libretranslate && ./start.sh",
    "reverse-translate": "ssh -N -R 3005:localhost:3005 translate.$USER.me",
    "start-multiplayer": "cd server/multiplayer && npm i && node index.mjs",
    "reverse-multiplayer": "ssh -N -R 9208:localhost:9208 multiplayer.$USER.me",
    "start-database": "cd server/private && ./pocketbase serve",
    "reverse-database": "ssh -N -R 8090:localhost:8090 pocket.$USER.me",
    "thumb-drive": "sudo mount -t 9p -o trans=tcp,port=7777,uname=$USER 127.0.0.1 /home/$USER/thumb-drive",
    "unthumb-drive": "sudo umount /home/$USER/thumb-drive",
    "package-assets": "cp -r client/public sillyz.computer/src",
    "native-dev": "deno task package-assets && cd sillyz.computer && cargo-tauri dev",
    "native-build": "deno task package-assets && cd sillyz.computer && NO_STRIP=true cargo-tauri build --bundles appimage",
    "mac-build": "deno task package-assets && cd sillyz.computer && NO_STRIP=true cargo-tauri build",
    "unix-install": "sudo cp sillyz.computer/src-tauri/target/release/bundle/appimage/sillyz_*.AppImage /home/tychi/Applications/sillyz.AppImage",
    "ios-init": "deno task package-assets && cd sillyz.computer && npm run tauri ios init",
    "ios-dev": "deno task package-assets && cd sillyz.computer && npm run tauri ios dev",
    "ios-build": "deno task package-assets && cd sillyz.computer && npm run tauri ios build",
    "android-init": "deno task package-assets && cd sillyz.computer && npm run tauri android init",
    "android-dev": "deno task package-assets && cd sillyz.computer && npm run tauri android dev",
    "android-build": "deno task package-assets && cd sillyz.computer && npm run tauri android dev",
    "chunk-video": "deno run --allow-run --allow-read --allow-write functions/convert.js",
    "provision-ollama": "cd server/ollama && ./provision.sh",
    "ollama-start-deepseek": "ollama run deepseek-r1:1.5b",
    "ollama-start-mistral": "ollama run mistral:7b",
    "ollama-start-gemma": "ollama run gemma3:1b",
    "ollama-start-llama": "ollama run llama3.2:3b",
    "ollama-stop-deepseek": "ollama stop deepseek-r1:1.5b",
    "ollama-stop-mistral": "ollama stop mistral:7b",
    "ollama-stop-gemma": "ollama stop gemma3:1b",
    "ollama-stop-llama": "ollama stop llama3.2:3b"
  },
  "imports": {
    "@silly/tag": "./client/public/module.js",
    "@silly/elf": "./client/public/elf.js",
    "@silly/saga": "./client/public/saga.js",
    "@plan98/types": "./client/public/types.js",
    "@sillonious/saga": "./client/public/saga.js",
    "@sillonious/brand": "./client/public/brand.js",
    "colorjs.io": "https://esm.sh/colorjs.io@0.4.0",
    "diffhtml": "https://esm.sh/diffhtml@1.0.0-beta.30",
    "statebus": "./client/public/_statebus.js",
    "marked": "https://esm.sh/marked@11.1.0",
    "@cross/deepmerge": "jsr:@cross/deepmerge@^1.0.0",
    "@cross/env": "jsr:@cross/env@^1.0.2",
    "@cross/kv": "jsr:@cross/kv@^0.16.3",
    "@cross/fs": "jsr:@cross/fs@^0.1.11",
    "@cross/jwt": "jsr:@cross/jwt@^0.4.6",
    "@cross/runtime": "jsr:@cross/runtime@^1.0.0",
    "@cross/service": "jsr:@cross/service@^1.0.3",
    "@cross/test": "jsr:@cross/test@^0.0.9",
    "@cross/utils": "jsr:@cross/utils@^0.14.0",
    "@hexagon/croner": "jsr:@hexagon/croner@^8.0.2",
    "@oak/oak": "jsr:@oak/oak@^15.0.0",
    "@pup/api-client": "jsr:@pup/api-client@^1.0.4",
    "@pup/api-definitions": "jsr:@pup/api-definitions@^1.0.2",
    "@pup/common": "jsr:@pup/common@^1.0.3",
    "@pup/plugin": "jsr:@pup/plugin@^1.0.1",
    "@std/assert": "jsr:@std/assert@^0.224.0",
    "@std/async": "jsr:@std/async@^0.224.0",
    "@std/encoding": "jsr:@std/encoding@^0.224.0",
    "@std/io": "jsr:@std/io@^0.224.0",
    "@std/path": "jsr:@std/path@^0.224.0",
    "@std/semver": "jsr:@std/semver@^0.224.0",
    "@std/dotenv": "jsr:@std/dotenv",
    "dax-sh": "npm:dax-sh@^0.40.0",
    "filesize": "npm:filesize@^10.1.1",
    "json5": "npm:json5@^2.2.3",
    "lunr": "npm:lunr@2.3.9",
    "timeago.js": "npm:timeago.js@^4.0.2",
    "zod": "npm:zod@^3.22.4",
    "zod-to-json-schema": "npm:zod-to-json-schema@^3.22.5"
  },
  "compilerOptions": {}
}
