{
  "name": "plan98",
  "processes": [
    {
      "id": "plan98-start-client",
      "cmd": "deno run -A client.js",
      "autostart": true
    },
    {
      "id": "plan98-start-multiplayer",
      "cmd": "cd server/multiplayer && npm i && node index.mjs",
      "autostart": true
    },
    {
      "id": "plan98-start-was",
      "cmd": "cd server/was/wallet-attached-storage-server-main && npm run dev",
      "autostart": true
    }
  ]
}
